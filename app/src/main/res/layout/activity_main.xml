<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="14dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:importantForAccessibility="no"
                android:src="@drawable/app_icon" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/foreground"
                android:textSize="19sp" />

            <Button
                android:id="@+id/tutorials"
                style="@style/StudioUtility"
                android:text="@string/studio_help" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_hero_gradient"
            android:clipToOutline="true"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="208dp"
                android:importantForAccessibility="noHideDescendants">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/studio_cover" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/studio_cover_scrim" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:fontFamily="serif"
                    android:lineSpacingMultiplier="0.93"
                    android:paddingHorizontal="19dp"
                    android:paddingBottom="14dp"
                    android:text="@string/studio_cover_title"
                    android:textColor="@color/foreground"
                    android:textSize="37sp" />
            </FrameLayout>

            <Button
                android:id="@+id/create"
                style="@style/HomeButton.Primary"
                android:layout_height="52dp"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="12dp"
                android:drawableEnd="@drawable/ic_arrow_right"
                android:text="@string/studio_new_design" />
        </LinearLayout>

        <TextView
            style="@style/StudioSectionTitle"
            android:text="@string/studio_start_with" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">
                <Button
                    android:id="@+id/open_photo"
                    style="@style/StudioShortcut"
                    android:layout_marginEnd="8dp"
                    android:drawableTop="@drawable/ic_gallery"
                    android:text="@string/studio_photo" />
                <Button
                    android:id="@+id/classic"
                    style="@style/StudioShortcut"
                    android:layout_marginEnd="8dp"
                    android:drawableTop="@drawable/ic_edit_text"
                    android:text="@string/studio_blank" />
                <Button
                    android:id="@+id/collage"
                    style="@style/StudioShortcut"
                    
                    android:drawableTop="@drawable/ic_home_collage"
                    android:text="@string/collage" />
        </LinearLayout>

        <TextView
            style="@style/StudioSectionTitle"
            android:text="@string/studio_library" />

        <Button
            android:id="@+id/more"
            style="@style/HomeButton"
            android:layout_marginBottom="0dp"
            android:drawableStart="@drawable/ic_gallery"
            android:drawableEnd="@drawable/ic_arrow_right"
            android:text="@string/studio_exports" />
    </LinearLayout>
</ScrollView>
