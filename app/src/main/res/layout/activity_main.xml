<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/home_logo_card"
            android:clipToOutline="true"
            android:contentDescription="@string/logo_description"
            android:scaleType="fitCenter"
            android:src="@drawable/app_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/font_default"
            android:letterSpacing="0.04"
            android:text="TEXT SWAG"
            android:textColor="@color/foreground"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/badge_pro"
            android:fontFamily="@font/font_default"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:paddingHorizontal="10dp"
            android:text="STUDIO PRO"
            android:textColor="@color/accent"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <!-- Hero Creation Banner -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/bg_ai_glow" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_hero_gradient"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/font_default"
                            android:text="Create New Design"
                            android:textColor="@color/foreground"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_ai_spark"
                            android:tint="@color/accent" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="18dp"
                        android:fontFamily="@font/font_default"
                        android:lineSpacingExtra="2dp"
                        android:text="Select from 100+ curated backgrounds, textures, or palettes and craft typography."
                        android:textColor="@color/foreground_secondary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/create"
                        style="@style/HomeButton.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="0dp"
                        android:drawableStart="@drawable/ic_background"
                        android:drawablePadding="10dp"
                        android:gravity="center"
                        android:text="Choose Background &amp; Start"
                        android:textAllCaps="false"
                        android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Section Title: Studio Modules -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/font_default"
                android:letterSpacing="0.08"
                android:text="STUDIO MODULES"
                android:textColor="@color/foreground_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Row 1: Photo Studio & Collage Maker -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Photo Studio Card -->
                <LinearLayout
                    android:id="@+id/open_photo"
                    android:layout_width="0dp"
                    android:layout_height="124dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/card_studio_tile"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/toolbar_icon_background"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_home_gallery"
                        android:tint="@color/accent" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/font_default"
                        android:text="Photo Studio"
                        android:textColor="@color/foreground"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/font_default"
                        android:maxLines="1"
                        android:text="Import &amp; edit photo"
                        android:textColor="@color/foreground_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Collage Maker Card -->
                <LinearLayout
                    android:id="@+id/collage"
                    android:layout_width="0dp"
                    android:layout_height="124dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/card_studio_tile"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/toolbar_icon_background"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_home_collage"
                        android:tint="@color/accent_purple" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/font_default"
                        android:text="Collage Maker"
                        android:textColor="@color/foreground"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/font_default"
                        android:maxLines="1"
                        android:text="Multi-photo &amp; glitch"
                        android:textColor="@color/foreground_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2: Blank Canvas & AI Studio -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Blank Canvas Card -->
                <LinearLayout
                    android:id="@+id/classic"
                    android:layout_width="0dp"
                    android:layout_height="124dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/card_studio_tile"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/toolbar_icon_background"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_edit_text"
                        android:tint="@color/accent" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/font_default"
                        android:text="Blank Canvas"
                        android:textColor="@color/foreground"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/font_default"
                        android:maxLines="1"
                        android:text="Pure typographic poster"
                        android:textColor="@color/foreground_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- AI Studio Card -->
                <LinearLayout
                    android:id="@+id/ai_studio"
                    android:layout_width="0dp"
                    android:layout_height="124dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/card_studio_tile"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/toolbar_icon_background"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_ai_spark"
                        android:tint="#FFB300" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/font_default"
                        android:text="AI Studio"
                        android:textColor="@color/foreground"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/font_default"
                        android:maxLines="1"
                        android:text="Smart style engine"
                        android:textColor="@color/foreground_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Creative Highlights Strip -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/font_default"
                android:letterSpacing="0.08"
                android:text="STUDIO HIGHLIGHTS"
                android:textColor="@color/foreground_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/home_link_background"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="✨ 136 Style Presets"
                        android:textColor="@color/foreground"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/home_link_background"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="🖊️ Neon &amp; Dash Brush"
                        android:textColor="@color/foreground"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/home_link_background"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="🔄 Curved Text"
                        android:textColor="@color/foreground"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/home_link_background"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="📐 Glitch &amp; Tone Curves"
                        android:textColor="@color/foreground"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/home_link_background"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="📷 1080p Ultra HD Export"
                        android:textColor="@color/foreground"
                        android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Studio Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/tutorials"
            style="@style/HomeLink"
            android:layout_marginEnd="6dp"
            android:drawableStart="@drawable/ic_ai_spark"
            android:drawablePadding="6dp"
            android:drawableTint="@color/accent"
            android:paddingHorizontal="12dp"
            android:text="Tutorials &amp; Tips"
            android:textColor="@color/foreground" />

        <TextView
            android:id="@+id/more"
            style="@style/HomeLink"
            android:layout_marginStart="6dp"
            android:drawableStart="@drawable/ic_gallery"
            android:drawablePadding="6dp"
            android:drawableTint="@color/foreground_secondary"
            android:paddingHorizontal="12dp"
            android:text="Export Gallery"
            android:textColor="@color/foreground_secondary" />
    </LinearLayout>
</LinearLayout>
