<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/decorator_categories"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/panel"
    android:baselineAligned="false"
    android:gravity="center"
    android:padding="12dp"
    android:visibility="gone">

    <Button
        android:id="@+id/decorator_borders"
        style="@style/FeatureButton"
        android:layout_height="96dp"
        android:layout_margin="4dp"
        android:drawableTop="@drawable/ic_border"
        android:text="Borders" />

    <Button
        android:id="@+id/decorator_lines"
        style="@style/FeatureButton"
        android:layout_height="96dp"
        android:layout_margin="4dp"
        android:drawableTop="@drawable/ic_line"
        android:text="Lines" />

    <Button
        android:id="@+id/decorator_typography"
        style="@style/FeatureButton"
        android:layout_height="96dp"
        android:layout_margin="4dp"
        android:drawableTop="@drawable/ic_instant"
        android:text="Typography" />
</LinearLayout>
