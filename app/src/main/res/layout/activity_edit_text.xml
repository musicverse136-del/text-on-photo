<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/panel"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/close"
            style="@style/ToolbarIcon"
            android:layout_gravity="center_vertical|start"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:fontFamily="@font/font_default"
            android:gravity="center"
            android:text="@string/edit_text_title"
            android:textColor="@color/foreground"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/confirm_text"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical|end"
            android:background="@drawable/export_button_background"
            android:contentDescription="@string/done"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_checked"
            android:tint="#17131B" />
    </FrameLayout>

    <!-- Text Input Box -->
    <EditText
        android:id="@+id/quote_text_input"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/edit_text_outline"
        android:fontFamily="@font/font_default"
        android:gravity="top|start"
        android:hint="@string/edit_text_hint"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLength="280"
        android:padding="14dp"
        android:textColor="@color/foreground"
        android:textColorHint="@color/foreground_muted"
        android:textSize="16sp" />

    <!-- Suggestions Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/font_default"
            android:text="@string/quote_suggestions"
            android:textColor="@color/foreground_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/clear_text"
            android:layout_width="78dp"
            android:layout_height="30dp"
            android:background="@drawable/quote_clear_background"
            android:fontFamily="@font/font_default"
            android:gravity="center"
            android:text="@string/clear_text"
            android:textColor="@color/danger"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Category Tabs -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@color/panel"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/quote_tabs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp" />
    </HorizontalScrollView>

    <!-- Quotes List -->
    <ListView
        android:id="@+id/quote_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:paddingTop="6dp"
        android:scrollbars="none" />
</LinearLayout>
