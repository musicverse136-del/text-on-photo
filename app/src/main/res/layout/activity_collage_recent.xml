<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/panel"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/recent_back"
            style="@style/ToolbarIcon"
            android:layout_gravity="center_vertical|start"
            android:contentDescription="Back"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:fontFamily="@font/font_default"
            android:gravity="center"
            android:text="Select Photos"
            android:textColor="@color/foreground"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/recent_browse"
            style="@style/ToolbarIcon"
            android:layout_gravity="center_vertical|end"
            android:contentDescription="Browse photos"
            android:src="@drawable/ic_gallery" />
    </FrameLayout>

    <!-- Photo Gallery Grid -->
    <GridView
        android:id="@+id/recent_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface"
        android:horizontalSpacing="4dp"
        android:numColumns="4"
        android:padding="4dp"
        android:verticalSpacing="4dp" />

    <!-- Action Bar & Counter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@color/panel"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/recent_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/font_default"
            android:textColor="@color/foreground"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/recent_start"
            style="@style/HomeButton.Primary"
            android:layout_width="110dp"
            android:layout_height="40dp"
            android:layout_marginBottom="0dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Start"
            android:textAllCaps="false"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Selected Photos Strip -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="@color/surface_card"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/recent_selected"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp" />
    </HorizontalScrollView>
</LinearLayout>
