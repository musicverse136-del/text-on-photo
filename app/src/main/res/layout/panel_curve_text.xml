<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/curve_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/panel"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:visibility="gone">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/home_link_background"
        android:fontFamily="@font/font_default"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:text="@string/curve_notice"
        android:textColor="#FBBF24"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        android:baselineAligned="false"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/font_default"
            android:text="@string/curve"
            android:textColor="@color/foreground"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/curve_reset"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/curve_reset_background"
            android:contentDescription="@string/reset_curve"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_none" />

        <SeekBar
            android:id="@+id/curve_amount"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:contentDescription="@string/curve"
            android:max="200"
            android:progress="100"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />

        <TextView
            android:id="@+id/curve_value"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/font_default"
            android:gravity="end"
            android:textColor="@color/foreground"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
