<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/panel"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/collage_back"
            style="@style/ToolbarIcon"
            android:layout_gravity="center_vertical|start"
            android:contentDescription="Back"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:fontFamily="@font/font_default"
            android:gravity="center"
            android:text="Collage Maker"
            android:textColor="@color/foreground"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/collage_done"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical|end"
            android:background="@drawable/export_button_background"
            android:contentDescription="Done"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_checked"
            android:tint="#0D0E13" />
    </FrameLayout>

    <!-- Canvas Preview Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface"
        android:padding="8dp">

        <com.textswag.studio.CollageBoard
            android:id="@+id/collage_canvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Collage preview" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/collage_tool_back"
        android:layout_width="38dp"
        android:layout_height="34dp"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/curve_reset_background"
        android:contentDescription="Collage tools"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/curve_back_arrow"
        android:visibility="gone" />

    <!-- Tool Panels -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="204dp"
        android:background="@color/panel"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/collage_tools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp" />
    </ScrollView>
</LinearLayout>
