<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="surface">#17131B</color>
    <color name="surface_card">#231B2A</color>
    <color name="surface_card_elevated">#30243B</color>
    <color name="panel">#201925</color>
    <color name="panel_border">#3B2D46</color>
    <color name="foreground">#FFF5EC</color>
    <color name="foreground_secondary">#D1C3D4</color>
    <color name="foreground_muted">#AC99AF</color>
    <color name="accent">#FFD09B</color>
    <color name="accent_purple">#C7A9F3</color>
    <color name="inactive_tab">#291F31</color>
    <color name="active_tab">#423047</color>
    <color name="card_stroke">#473652</color>
    <color name="button_bg">#2B2033</color>
    <color name="button_stroke">#4C3958</color>
    <color name="success">#9EE6BF</color>
    <color name="danger">#FF9C9E</color>
    <color name="badge_bg">#29FFD09B</color>

    <dimen name="home_button_corner_radius">18dp</dimen>
    <dimen name="home_button_stroke_width">1.5dp</dimen>

    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:alertDialogTheme">@style/StudioDialog</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/foreground</item>
        <item name="android:textColorSecondary">@color/foreground_secondary</item>
        <item name="android:colorControlNormal">@color/foreground_secondary</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorControlHighlight">#25FFD09B</item>
    </style>

    <style name="HomeButton" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:background">@drawable/home_button_outline</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:fontFamily">@font/font_default</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:drawableTint">@color/accent</item>
        <item name="android:drawablePadding">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="HomeButton.Primary">
        <item name="android:background">@drawable/home_button_primary</item>
        <item name="android:textColor">#17131B</item>
        <item name="android:textStyle">bold</item>
        <item name="android:drawableTint">#17131B</item>
    </style>

    <style name="HomeLink">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/font_default</item>
        <item name="android:textColor">@color/foreground_secondary</item>
        <item name="android:background">@drawable/home_link_background</item>
    </style>

    <style name="ToolbarIcon">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/toolbar_icon_background</item>
        <item name="android:tint">@color/foreground</item>
    </style>

    <style name="FeatureButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:drawableTint">@color/foreground_secondary</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:fontFamily">@font/font_default</item>
        <item name="android:background">@drawable/feature_tile_selector</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="EditorTab" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:padding">0dp</item>
        <item name="android:textColor">@color/tab_text_selector</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/editor_tab</item>
        <item name="android:fontFamily">@font/font_default</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="StudioUtility" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/home_link_background</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="StudioShortcut" parent="FeatureButton">
        <item name="android:layout_height">82dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:background">@drawable/card_studio_tile</item>
        <item name="android:drawableTint">@color/accent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="StudioSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">17sp</item>
    </style>
</resources>
